// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GUEST
  ADMIN
}

enum GuestStatus {
  PENDING
  INVITED
  RESPONDED
  BOUNCED
}

enum EmailType {
  SAVE_THE_DATE
  INVITE
  INVITATION
  REMINDER
  CONFIRMATION
  INFO
  CUSTOM
}

enum EmailStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

enum EmailProvider {
  SENDGRID
  RESEND
  MAILGUN
  SMTP
}

enum ModuleType {
  REGISTRATION_PAYMENT
  TRANSPORT
  ACCOMMODATION
  PROGRAM
  BUDGET
  MULTILANG
}

enum TransportType {
  FLIGHT
  TRAIN
  SHUTTLE
  TAXI
  CAR_RENTAL
  PERSONAL_CAR
}

enum BookingStatus {
  REQUESTED
  PENDING
  CONFIRMED
  BOOKED
  CANCELLED
  COMPLETED
}

enum ManifestStatus {
  DRAFT
  OPEN
  FULL
  CONFIRMED
  DEPARTED
  COMPLETED
  CANCELLED
}

enum SessionType {
  KEYNOTE
  WORKSHOP
  CONFERENCE
  TEAMBUILDING
  MEAL
  BREAK
  TRANSFER
  ARRIVAL
  DEPARTURE
  FREE_TIME
  NETWORKING
  TRAINING
  PANEL
  OTHER
}

enum SessionStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum TimelineType {
  SESSION
  TRANSPORT_ARRIVAL
  TRANSPORT_DEPARTURE
  HOTEL_CHECKIN
  HOTEL_CHECKOUT
  MEAL
  BREAK
  TRANSFER
  FREE_TIME
  CUSTOM
}

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  TRIPLE
  SUITE
  STUDIO
  APARTMENT
}

enum RoomStatus {
  AVAILABLE
  ASSIGNED
  BLOCKED
  MAINTENANCE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String   // Hashed with bcrypt
  role      UserRole @default(ADMIN)

  // Security
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  loginAttempts Int      @default(0)
  lockedUntil  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  adminEvents Event[] @relation("AdminEvents")

  @@index([email])
}

model Event {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  startsAt    DateTime
  endsAt      DateTime?
  venueName   String?
  address     String?
  city        String?
  country     String?
  coverImage  String?
  description String?   @db.Text
  program     String?   @db.Text
  dressCode   String?

  // RSVP Configuration
  rsvpDeadline   DateTime?
  maxPlusOnes    Int       @default(0)
  allowPlusOnes  Boolean   @default(false)
  requireMeal    Boolean   @default(false)
  mealOptions    String[]  @default([])

  // Enhanced fields
  capacity            Int?      // Capacité maximale participants
  registrationDeadline DateTime? // Date limite inscription
  hashtag             String?   // Hashtag événement (#MyEvent2025)
  socialMediaUrls     Json?     // {twitter, instagram, linkedin, facebook}
  budgetTotal         Float?    // Budget total événement
  budgetCurrency      String    @default("EUR")

  // Communication Configuration
  saveTheDateConfig  Json? // Save the Date email configuration
  invitationConfig   Json? // Invitation email configuration
  rsvpConfig         Json? // RSVP form configuration

  // Features enabled
  enableTransport   Boolean @default(false)
  enableLodging     Boolean @default(false)
  enableAccessibility Boolean @default(true)
  enablePhotoConsent Boolean @default(true)

  // Showcase page configuration
  showcaseEnabled       Boolean @default(true)
  showcaseTitle         String?
  showcaseSubtitle      String?
  showcaseBannerImage   String?
  showcaseTheme         String  @default("weevup") // "weevup", "elegant", "modern", "minimal"
  showcaseSections      Json?   // Array of SectionConfig objects with advanced settings
  showcaseCustomCSS     String? @db.Text
  showcasePrimaryColor  String  @default("#004645")
  showcaseSecondaryColor String @default("#FF4713")

  // Advanced showcase content
  showcaseGallery       Json?   // Array of image URLs for gallery
  showcaseFAQ           Json?   // Array of {question, answer} objects
  showcaseSpeakers      Json?   // Array of speaker objects {name, title, bio, photo}
  showcaseSponsors      Json?   // Array of sponsor objects {name, logo, url}
  showcaseTimeline      Json?   // Array of timeline items {time, title, description}
  showcaseVideo         String? // YouTube or Vimeo embed URL
  showcaseSocialShare   Boolean @default(true)
  showcaseCountdown     Boolean @default(true)
  showcaseSectionContents Json?   // Custom content per section {sectionId: {title, subtitle, description, image, buttons, customHTML}}

  // Admin
  adminId String
  admin   User   @relation("AdminEvents", fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  guests         Guest[]
  rsvps          RSVP[]
  checkins       Checkin[]
  emailLogs      EmailLog[]
  emailTrackings EmailTracking[] // @deprecated

  // Phase 2: Modular features
  modules              EventModule[]        @relation("EventModules")
  transportBookings    TransportBooking[]   @relation("EventTransportBookings")
  transportManifests   TransportManifest[]  @relation("EventTransportManifests")
  sessions             Session[]            @relation("EventSessions")
  timelineEvents       TimelineEvent[]      @relation("EventTimelineEvents")
  accommodations       Accommodation[]      @relation("EventAccommodations")

  // Phase 3: Scheduled emails & auto-reminders
  scheduledEmails      ScheduledEmail[]     @relation("EventScheduledEmails")
  remindersConfig      EventRemindersConfig? @relation("EventRemindersConfig")

  // Phase 2.5: Badge system
  badgeDesign          BadgeDesign?         @relation("EventBadgeDesign")

  // SMS Notifications
  notifications        Notification[]       @relation("EventNotifications")
  smsTemplates         SMSTemplate[]        @relation("EventSMSTemplates")
  smsCampaigns         SMSCampaign[]        @relation("EventSMSCampaigns")
  scheduledSMS         ScheduledSMS[]       @relation("EventScheduledSMS")

  @@index([slug])
  @@index([adminId])
}

model Guest {
  id        String      @id @default(cuid())
  eventId   String
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String?
  email     String
  company   String?
  tags      String[]    @default([])

  // Professional information
  jobTitle      String?     // Fonction/Poste
  department    String?     // Département
  companySize   String?     // Taille entreprise (TPE, PME, ETI, GE)
  industry      String?     // Secteur d'activité
  linkedinUrl   String?     // Profil LinkedIn
  phoneNumber   String?     // Numéro de téléphone

  // SMS Notifications
  phone         String?     // Phone number for SMS (international format: +33612345678)
  phoneVerified Boolean     @default(false)

  // Event-specific needs
  dietaryReqs   String?     @db.Text  // Restrictions alimentaires (JSON: {type, allergens, details})
  accessibility String?     @db.Text  // Besoins d'accessibilité
  adminNotes    String?     @db.Text  // Notes privées admin

  // Enhanced fields
  emergencyContact  Json?       // Contact urgence: {name, phone, relationship}
  tShirtSize        String?     // Taille vêtement (XS, S, M, L, XL, XXL)
  arrivalTime       DateTime?   // Heure d'arrivée précise
  departureTime     DateTime?   // Heure de départ précise

  // Badge photo
  photoUrl          String?     // URL Vercel Blob Storage for badge photo
  photoUploadedAt   DateTime?   // Timestamp of photo upload

  // Authentication
  token         String      @unique // Will be hashed
  tokenHash     String      @unique // Hashed version for lookup
  tokenExpiry   DateTime?

  // Status tracking
  status        GuestStatus @default(PENDING)
  lastEmailAt   DateTime?

  // Invitation tracking
  invitationSentAt   DateTime?
  invitationEmailId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rsvp           RSVP?
  checkins       Checkin[]
  emailLogs      EmailLog[]
  emailTrackings EmailTracking[] // @deprecated

  // Phase 2: Modular features
  transportBookings TransportBooking[]    @relation("GuestTransportBookings")
  manifests         ManifestParticipant[] @relation("GuestManifests")
  sessionParticipations SessionParticipant[] @relation("GuestSessions")
  roomAssignments   RoomAssignment[]      @relation("GuestRoomAssignments")

  // Phase 2.5: Badge system
  badge             Badge?                @relation("GuestBadge")

  // SMS Notifications
  notifications     Notification[]        @relation("GuestNotifications")
  scheduledSMS      ScheduledSMS[]        @relation("GuestScheduledSMS")
  smsOptOuts        SMSOptOut[]           @relation("GuestSMSOptOut")

  @@unique([eventId, email])
  @@index([tokenHash])
  @@index([eventId])
}

model RSVP {
  id       String  @id @default(cuid())
  eventId  String
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId  String  @unique
  guest    Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)

  // Response
  attending Boolean?
  plusOnes  Int      @default(0)

  // Meal preferences
  mealChoice String?
  allergies  String?  @db.Text

  // Additional info
  accessibilityNotes String? @db.Text
  transportNeeds     String? @db.Text
  lodgingNeeds       String? @db.Text

  // Consents
  consentPhotos Boolean @default(false)

  // QR Code for check-in
  qrCodeId String @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model Checkin {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId    String
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  qrCodeId     String
  checkedInAt  DateTime @default(now())
  desk         String?
  notes        String?

  @@index([eventId])
  @@index([guestId])
}

model EmailLog {
  id         String      @id @default(cuid())
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId    String
  guest      Guest       @relation(fields: [guestId], references: [id], onDelete: Cascade)

  type       EmailType
  status     EmailStatus @default(PENDING)

  subject    String
  providerId String?

  sentAt     DateTime?
  openedAt   DateTime?
  clickedAt  DateTime?
  bouncedAt  DateTime?

  error      String?     @db.Text

  createdAt  DateTime    @default(now())

  @@index([eventId])
  @@index([guestId])
  @@index([status])
}

// @deprecated Use EmailLog instead. Kept for backward compatibility.
model EmailTracking {
  id        String   @id // Format: eventId-guestId-type-timestamp
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  type      String   // "save-the-date", "invitation", "reminder", "follow-up"
  status    String   // "sent", "delivered", "opened", "clicked", "failed"

  sentAt    DateTime @default(now())
  openedAt  DateTime?
  clickedAt DateTime?

  @@index([eventId])
  @@index([guestId])
  @@index([type])
  @@index([status])
}

model EmailIntegration {
  id        String        @id @default(cuid())

  // Provider configuration
  provider  EmailProvider
  isActive  Boolean       @default(false)
  isPrimary Boolean       @default(false) // Only one can be primary

  // API Configuration (stored encrypted in production)
  apiKey    String?       // Encrypted API key
  apiSecret String?       // Encrypted secret (for some providers)

  // SMTP specific fields
  smtpHost  String?
  smtpPort  Int?
  smtpUser  String?
  smtpPass  String?       // Encrypted

  // Sender configuration
  fromEmail String?
  fromName  String?
  replyTo   String?

  // Webhooks & tracking
  webhookUrl String?
  webhookSecret String?   // Encrypted
  trackOpens Boolean     @default(true)
  trackClicks Boolean    @default(true)

  // Limits & quotas
  dailyLimit Int?
  monthlyLimit Int?

  // Metadata
  lastTestedAt DateTime?
  lastUsedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([isActive])
  @@index([isPrimary])
}

model EmailTemplate {
  id          String    @id @default(cuid())

  // Template info
  name        String
  slug        String    @unique
  description String?
  type        EmailType // INVITE, REMINDER, CONFIRMATION, etc.

  // Template content
  subject     String
  htmlContent String    @db.Text
  textContent String?   @db.Text

  // Design settings
  primaryColor   String  @default("#004645")
  secondaryColor String  @default("#009197")
  accentColor    String  @default("#FF4713")
  fontFamily     String  @default("Arial, sans-serif")

  // Status
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)

  // Preview image
  previewImage String?

  // Usage tracking
  usageCount  Int       @default(0)
  lastUsedAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@index([isActive])
  @@index([isDefault])
}

// ============================================
// PHASE 2: MODULAR FEATURES
// ============================================

model EventModule {
  id         String     @id @default(cuid())
  eventId    String
  event      Event      @relation("EventModules", fields: [eventId], references: [id], onDelete: Cascade)

  moduleType ModuleType
  isActive   Boolean    @default(true)
  config     Json?      // Module-specific configuration

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([eventId, moduleType])
  @@index([eventId])
  @@index([moduleType])
}

model TransportBooking {
  id        String        @id @default(cuid())
  eventId   String
  event     Event         @relation("EventTransportBookings", fields: [eventId], references: [id], onDelete: Cascade)
  guestId   String
  guest     Guest         @relation("GuestTransportBookings", fields: [guestId], references: [id], onDelete: Cascade)

  // Transport details
  type      TransportType
  status    BookingStatus @default(REQUESTED)

  // Journey details (flexible JSON for different transport types)
  departure      Json?     // { city, airport, station, address, date, time }
  arrival        Json?     // { city, airport, station, address, date, time }
  carrier        String?   // Company name (Air France, SNCF, etc.)
  bookingRef     String?   // Booking reference
  seatNumber     String?   // Seat number

  // Timing (parsed from JSON for easy querying)
  departureTime  DateTime?
  arrivalTime    DateTime?

  // Costs
  estimatedCost  Float?
  actualCost     Float?
  currency       String    @default("EUR")
  isPaidByCompany Boolean  @default(true)

  // Notes
  notes          String?   @db.Text
  internalNotes  String?   @db.Text  // Admin-only notes

  // Link to manifest (shuttle)
  manifestId     String?
  manifest       TransportManifest? @relation("ManifestBookings", fields: [manifestId], references: [id])

  // Link to arrival/departure session
  linkedSessionId String?
  linkedSession   Session?   @relation("SessionTransports", fields: [linkedSessionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([guestId])
  @@index([status])
  @@index([type])
  @@index([departureTime])
  @@index([arrivalTime])
}

model TransportManifest {
  id          String             @id @default(cuid())
  eventId     String
  event       Event              @relation("EventTransportManifests", fields: [eventId], references: [id], onDelete: Cascade)

  type        TransportType
  name        String             // e.g., "Airport Shuttle - Hotel"
  description String?            @db.Text

  // Journey details
  departure   Json               // { location, date, time }
  arrival     Json               // { location, date, time }

  // Timing (parsed from JSON for easy querying and sorting)
  departureTime  DateTime?
  arrivalTime    DateTime?

  // Capacity
  maxCapacity Int?
  currentCount Int              @default(0)

  // Cost
  costPerPerson Float?
  currency      String           @default("EUR")

  // Status
  status        ManifestStatus   @default(DRAFT)

  // Driver & Vehicle info (for operational planning)
  driverName    String?
  driverPhone   String?
  vehicleInfo   String?          // Vehicle plate, model, color, etc.

  // Participants (many-to-many via pivot table)
  participants  ManifestParticipant[]

  // Bookings linked to this manifest
  bookings      TransportBooking[] @relation("ManifestBookings")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([status])
}

// Pivot table for many-to-many relationship
model ManifestParticipant {
  id          String             @id @default(cuid())
  manifestId  String
  manifest    TransportManifest  @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  guestId     String
  guest       Guest              @relation("GuestManifests", fields: [guestId], references: [id], onDelete: Cascade)

  seatNumber  String?
  confirmedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([manifestId, guestId])
  @@index([manifestId])
  @@index([guestId])
}

// ============================================
// PHASE 2: AGENDA & TIMELINE MODULE
// ============================================

model Session {
  id              String         @id @default(cuid())
  eventId         String
  event           Event          @relation("EventSessions", fields: [eventId], references: [id], onDelete: Cascade)

  // Session information
  title           String
  description     String?        @db.Text
  type            SessionType
  status          SessionStatus  @default(DRAFT)

  // Timing
  startTime       DateTime       // Date + heure de début
  endTime         DateTime       // Date + heure de fin
  duration        Int            // Duration in minutes

  // Location
  venue           String?        // "Hôtel Marriott"
  room            String?        // "Salle Lumière"
  address         String?        // Full address if different from event venue

  // Capacity management
  capacity        Int?           // Maximum participants
  minParticipants Int?           // Minimum for session to run
  requiresRegistration Boolean   @default(false)
  registrationDeadline DateTime?
  registrationsClosed  Boolean   @default(false)

  // Group management for workshops/team building
  requiresGroups  Boolean        @default(false) // Session needs group assignment

  // Speakers/Facilitators
  speakers        Json?          // Array of {name, title, bio, photo, email}

  // Logistics
  equipment       String[]       @default([]) // ["Projector", "Microphone", "Whiteboard"]
  materials       String?        @db.Text     // Materials needed
  catering        String?        // Coffee break, lunch, etc.

  // Enhanced fields
  prerequisites   String?        @db.Text     // Prérequis pour participer
  difficulty      String?        // Niveau: "beginner", "intermediate", "advanced"
  targetAudience  String?        @db.Text     // Public cible

  // Display settings
  color           String?        // Color for calendar display
  icon            String?        // Icon name for display
  isPublic        Boolean        @default(true) // Visible to participants?
  isHighlighted   Boolean        @default(false) // Featured session

  // Relations
  participants    SessionParticipant[]   @relation("SessionParticipants")
  transports      TransportBooking[]     @relation("SessionTransports")
  groups          SessionGroup[]         @relation("SessionGroups")

  // Timeline position
  timelineOrder   Int?           // Order in timeline

  // Metadata
  notes           String?        @db.Text   // Internal notes
  tags            String[]       @default([])

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([eventId, startTime])
  @@index([type])
  @@index([status])
}

model SessionParticipant {
  id              String   @id @default(cuid())
  sessionId       String
  session         Session  @relation("SessionParticipants", fields: [sessionId], references: [id], onDelete: Cascade)
  guestId         String
  guest           Guest    @relation("GuestSessions", fields: [guestId], references: [id], onDelete: Cascade)

  // Group assignment (for sessions requiring groups)
  groupId         String?
  group           SessionGroup? @relation("GroupParticipants", fields: [groupId], references: [id], onDelete: SetNull)

  // Registration status
  status          String   @default("registered") // registered, confirmed, waitlist, cancelled, attended
  waitlistPosition Int?

  // Check-in
  checkedInAt     DateTime?
  checkedInBy     String?  // Admin who checked in

  // Feedback (post-session)
  rating          Int?     // 1-5 stars
  feedback        String?  @db.Text

  // Metadata
  registeredAt    DateTime @default(now())
  notes           String?  @db.Text  // Special requests

  @@unique([sessionId, guestId])
  @@index([sessionId])
  @@index([guestId])
  @@index([groupId])
  @@index([status])
}

// Session Group for workshops/team building
model SessionGroup {
  id              String   @id @default(cuid())
  sessionId       String
  session         Session  @relation("SessionGroups", fields: [sessionId], references: [id], onDelete: Cascade)

  // Group information
  name            String   // "Groupe A", "Atelier Innovation", "Équipe Rouge"
  description     String?  @db.Text
  color           String?  // Color for display (hex code)
  capacity        Int?     // Max participants per group
  order           Int      @default(0) // Display order

  // Relations
  participants    SessionParticipant[] @relation("GroupParticipants")

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sessionId])
  @@index([sessionId, order])
}

model TimelineEvent {
  id          String         @id @default(cuid())
  eventId     String
  event       Event          @relation("EventTimelineEvents", fields: [eventId], references: [id], onDelete: Cascade)

  // Type of timeline event
  type        TimelineType

  // Timing
  startTime   DateTime
  endTime     DateTime?
  allDay      Boolean        @default(false)

  // Links to related entities
  sessionId         String?
  transportId       String?
  accommodationId   String?

  // Participants affected by this event
  affectedGuestIds  String[]  @default([]) // Array of guest IDs
  isGlobalEvent     Boolean   @default(false) // Affects all participants

  // Display information
  title       String
  description String?        @db.Text
  icon        String?        // Icon identifier (lucide icon name)
  color       String?        // Hex color for display
  location    String?        // Location summary

  // Priority and visibility
  priority    Int            @default(0) // Higher = more important
  isPublic    Boolean        @default(true) // Visible to participants?

  // Notifications
  notifyParticipants Boolean @default(false)
  notificationSent   Boolean @default(false)
  notifyBefore       Int?    // Minutes before to send notification

  // Order and grouping
  order       Int            @default(0)
  category    String?        // For grouping events

  // Metadata
  metadata    Json?          // Additional flexible data
  notes       String?        @db.Text

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([eventId, startTime])
  @@index([type])
  @@index([isPublic])
}

// ============================================
// PHASE 2: ACCOMMODATION MODULE
// ============================================

model Accommodation {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation("EventAccommodations", fields: [eventId], references: [id], onDelete: Cascade)

  // Basic information
  name            String   // Hotel name
  type            String   @default("HOTEL") // HOTEL, APARTMENT, HOSTEL, etc.
  address         String?
  city            String?
  country         String?
  postalCode      String?

  // Contact
  phone           String?
  email           String?
  website         String?
  contactPerson   String?

  // Location
  latitude        Float?
  longitude       Float?
  distanceFromVenue Float? // Distance in km

  // Facilities
  starRating      Int?     // 1-5 stars
  amenities       String[] @default([]) // ["WiFi", "Pool", "Gym", "Restaurant"]
  description     String?  @db.Text

  // Capacity
  totalRooms      Int      @default(0)
  allocatedRooms  Int      @default(0) // Rooms booked for the event

  // Check-in/out details
  checkInTime     String?  // "14:00"
  checkOutTime    String?  // "11:00"
  earlyCheckIn    Boolean  @default(false)
  lateCheckOut    Boolean  @default(false)

  // Costs
  contractRate    Float?   // Negotiated rate per room per night
  currency        String   @default("EUR")

  // Booking details
  blockStartDate  DateTime? // Start of room block
  blockEndDate    DateTime? // End of room block
  bookingDeadline DateTime? // Deadline for booking
  bookingRef      String?   // Hotel booking reference

  // Status
  isActive        Boolean  @default(true)
  isPreferred     Boolean  @default(false) // Official/preferred hotel

  // Internal notes
  notes           String?  @db.Text
  internalNotes   String?  @db.Text

  // Relations
  rooms           Room[]   @relation("AccommodationRooms")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([eventId])
  @@index([isActive])
}

model Room {
  id              String         @id @default(cuid())
  accommodationId String
  accommodation   Accommodation  @relation("AccommodationRooms", fields: [accommodationId], references: [id], onDelete: Cascade)

  // Room identification
  roomNumber      String         // "101", "Suite 5", etc.
  floor           Int?
  type            RoomType
  status          RoomStatus     @default(AVAILABLE)

  // Capacity
  maxOccupancy    Int            @default(1) // Max guests
  currentOccupancy Int           @default(0) // Current assigned guests

  // Features
  bedConfiguration String?       // "1 King", "2 Singles", etc.
  view            String?        // "Sea view", "Garden view", etc.
  isAccessible    Boolean        @default(false) // Wheelchair accessible
  isSmokingAllowed Boolean       @default(false)
  amenities       String[]       @default([])

  // Pricing
  ratePerNight    Float?
  currency        String         @default("EUR")

  // Availability
  availableFrom   DateTime?
  availableUntil  DateTime?

  // Notes
  notes           String?        @db.Text

  // Relations
  assignments     RoomAssignment[] @relation("RoomAssignments")

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([accommodationId, roomNumber])
  @@index([accommodationId])
  @@index([status])
  @@index([type])
}

model RoomAssignment {
  id              String        @id @default(cuid())
  roomId          String
  room            Room          @relation("RoomAssignments", fields: [roomId], references: [id], onDelete: Cascade)
  guestId         String
  guest           Guest         @relation("GuestRoomAssignments", fields: [guestId], references: [id], onDelete: Cascade)

  // Stay details
  checkInDate     DateTime
  checkOutDate    DateTime
  numberOfNights  Int           @default(1)

  // Primary guest indicator (for shared rooms)
  isPrimaryGuest  Boolean       @default(true)

  // Preferences matched
  preferencesMet  String[]      @default([]) // ["Non-smoking", "Ground floor"]

  // Special requests
  specialRequests String?       @db.Text

  // Status
  isConfirmed     Boolean       @default(false)
  confirmedAt     DateTime?
  confirmedBy     String?       // Admin ID

  // Payment
  isPaid          Boolean       @default(false)
  paidAmount      Float?
  currency        String        @default("EUR")

  // Notes
  notes           String?       @db.Text

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([roomId, guestId])
  @@index([roomId])
  @@index([guestId])
  @@index([checkInDate])
  @@index([checkOutDate])
}

// ============================================
// Phase 3: Scheduled Emails & Auto-Reminders
// ============================================

model ScheduledEmail {
  id        String   @id @default(cuid())

  // Event & Email info
  eventId   String
  event     Event    @relation("EventScheduledEmails", fields: [eventId], references: [id], onDelete: Cascade)

  type      EmailType // SAVE_THE_DATE, INVITE, REMINDER, FOLLOW_UP

  // Recipients (guests or specific list)
  guestIds  String[] // Array of guest IDs to send to

  // Schedule
  scheduledFor DateTime
  status       ScheduledEmailStatus @default(PENDING)

  // Optional template
  templateId   String?

  // Execution info
  sentAt       DateTime?
  errorMessage String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([eventId])
  @@index([scheduledFor])
  @@index([status])
}

model EventRemindersConfig {
  id       String  @id @default(cuid())

  eventId  String  @unique
  event    Event   @relation("EventRemindersConfig", fields: [eventId], references: [id], onDelete: Cascade)

  // Auto-reminders settings
  enabled  Boolean @default(false)

  // Follow-up reminder for non-responders
  followUpEnabled    Boolean @default(false)
  followUpDays       Int?     // Days after invitation to send follow-up

  // Pre-event reminder for confirmed guests
  preEventEnabled    Boolean @default(false)
  preEventDays       Int?     // Days before event to send reminder

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ScheduledEmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

// ============================================
// Phase 2.5: Badge System
// ============================================

enum BadgeSize {
  STANDARD      // 85.6mm × 54mm (credit card size)
  LARGE         // 100mm × 70mm
  LANYARD       // 100mm × 150mm
  A6            // 105mm × 148mm
}

enum BadgeOrientation {
  PORTRAIT
  LANDSCAPE
}

enum BadgeFieldType {
  FIRST_NAME
  LAST_NAME
  FULL_NAME
  COMPANY
  JOB_TITLE
  EMAIL
  QR_CODE
  EVENT_NAME
  EVENT_DATE
  CUSTOM_TEXT
  LOGO
  PHOTO
}

model BadgeTemplate {
  id          String  @id @default(cuid())
  name        String  // "Corporate Standard", "VIP", "Staff", "Speaker"
  description String? @db.Text

  // Template settings
  size        BadgeSize        @default(STANDARD)
  orientation BadgeOrientation @default(PORTRAIT)

  // Layout configuration (JSON)
  // {
  //   backgroundColor: "#ffffff",
  //   borderColor: "#004645",
  //   borderWidth: 2,
  //   sections: [
  //     { type: "header", height: 80, backgroundColor: "#004645" },
  //     { type: "body", height: 200 },
  //     { type: "footer", height: 60, backgroundColor: "#f5f5f5" }
  //   ]
  // }
  layout      Json

  // Field configuration (JSON)
  // [
  //   { id: "1", type: "FULL_NAME", x: 50, y: 120, fontSize: 24, fontWeight: "bold", color: "#333", align: "center" },
  //   { id: "2", type: "COMPANY", x: 50, y: 150, fontSize: 16, color: "#666", align: "center" },
  //   { id: "3", type: "QR_CODE", x: 150, y: 220, size: 80 }
  // ]
  fields      Json

  // Styling
  fontFamily  String   @default("Arial")

  // Preview image URL (auto-generated)
  previewUrl  String?

  // Default template for events
  isDefault   Boolean  @default(false)

  // Visibility
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  badgeDesigns BadgeDesign[] @relation("BadgeTemplateDesigns")

  @@index([isDefault])
  @@index([isActive])
}

model BadgeDesign {
  id          String  @id @default(cuid())

  // Event relation
  eventId     String  @unique
  event       Event   @relation("EventBadgeDesign", fields: [eventId], references: [id], onDelete: Cascade)

  // Template base (optional - can be fully custom)
  templateId  String?
  template    BadgeTemplate? @relation("BadgeTemplateDesigns", fields: [templateId], references: [id], onDelete: SetNull)

  // Custom design (overrides template)
  name        String  @default("Event Badge")
  size        BadgeSize        @default(STANDARD)
  orientation BadgeOrientation @default(PORTRAIT)

  // Layout & fields (same structure as template)
  layout      Json
  fields      Json

  // Styling
  fontFamily  String   @default("Arial")

  // Event logo
  eventLogoUrl String?

  // QR code settings
  includeQRCode Boolean @default(true)
  qrCodeSize    Int     @default(80) // pixels

  // Batch printing settings
  badgesPerPage Int     @default(10) // How many badges per A4 page
  pageMargin    Int     @default(10) // mm
  badgeSpacing  Int     @default(5)  // mm between badges

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  badges      Badge[]  @relation("BadgeDesignBadges")

  @@index([eventId])
  @@index([templateId])
}

model Badge {
  id          String   @id @default(cuid())

  // Guest relation
  guestId     String   @unique
  guest       Guest    @relation("GuestBadge", fields: [guestId], references: [id], onDelete: Cascade)

  // Design relation
  badgeDesignId String
  badgeDesign BadgeDesign @relation("BadgeDesignBadges", fields: [badgeDesignId], references: [id], onDelete: Cascade)

  // Generated badge data
  // Stores the rendered field values for this specific guest
  // {
  //   "FULL_NAME": "John Doe",
  //   "COMPANY": "Acme Inc",
  //   "JOB_TITLE": "CEO",
  //   "QR_CODE": "data:image/png;base64,..."
  // }
  renderedData Json

  // PDF URL (if pre-generated)
  pdfUrl       String?

  // Print tracking
  printedCount Int      @default(0)
  lastPrintedAt DateTime?
  printedBy    String?  // Admin ID who printed

  // Status
  isReady      Boolean  @default(false) // Ready to print
  isIssued     Boolean  @default(false) // Badge has been issued to guest
  issuedAt     DateTime?

  // Notes
  notes        String?  @db.Text

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([guestId])
  @@index([badgeDesignId])
  @@index([isReady])
  @@index([isIssued])
}

// ============================================
// SMS NOTIFICATIONS SYSTEM (MVP)
// ============================================

enum NotificationType {
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

model Notification {
  id          String   @id @default(cuid())

  // Recipient
  guestId     String
  guest       Guest    @relation("GuestNotifications", fields: [guestId], references: [id], onDelete: Cascade)

  // Event context
  eventId     String
  event       Event    @relation("EventNotifications", fields: [eventId], references: [id], onDelete: Cascade)

  // Message details
  type        NotificationType
  message     String   @db.Text
  subject     String?  // For future email/push support

  // Delivery tracking
  status      NotificationStatus @default(PENDING)
  sentAt      DateTime?
  deliveredAt DateTime?
  error       String?  @db.Text

  // Provider details (Twilio, etc.)
  provider    String?  // "twilio"
  providerId  String?  // External provider message ID
  providerResponse Json? // Full provider response

  // Metadata
  templateName String?  // e.g., "RSVP Confirmation"
  metadata    Json?    // Additional context

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([guestId])
  @@index([eventId])
  @@index([status])
  @@index([sentAt])
}

// ============================================
// ADVANCED SMS FEATURES
// ============================================

// SMS Template for reusable message templates with variables
model SMSTemplate {
  id          String   @id @default(cuid())

  // Template info
  name        String   // "RSVP Confirmation", "Reminder J-7", etc.
  description String?  @db.Text
  category    String   @default("custom") // "rsvp", "reminder", "info", "custom"

  // Message content with variables
  message     String   @db.Text // "Bonjour {firstName}, votre invitation pour {eventName} le {eventDate} est confirmée !"

  // Variables available (JSON array of variable names)
  variables   Json     @default("[]") // ["firstName", "lastName", "eventName", "eventDate", etc.]

  // Usage tracking
  usageCount  Int      @default(0)
  lastUsedAt  DateTime?

  // Status
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)

  // Owner (global or event-specific)
  eventId     String?
  event       Event?   @relation("EventSMSTemplates", fields: [eventId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  campaigns   SMSCampaign[] @relation("CampaignTemplate")

  @@index([eventId])
  @@index([category])
  @@index([isActive])
}

// SMS Campaign for grouped scheduled sends
model SMSCampaign {
  id          String   @id @default(cuid())

  // Campaign info
  name        String   // "Rappel J-7 Gala 2025"
  description String?  @db.Text

  // Event relation
  eventId     String
  event       Event    @relation("EventSMSCampaigns", fields: [eventId], references: [id], onDelete: Cascade)

  // Template
  templateId  String?
  template    SMSTemplate? @relation("CampaignTemplate", fields: [templateId], references: [id], onDelete: SetNull)

  // Message (if not using template)
  message     String?  @db.Text

  // Targeting
  targetType  String   @default("manual") // "all", "confirmed", "pending", "tags", "manual"
  targetTags  String[] @default([]) // If targetType = "tags"
  guestIds    String[] @default([]) // If targetType = "manual"

  // Scheduling
  scheduledFor DateTime?
  status      SMSCampaignStatus @default(DRAFT)

  // Execution tracking
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  sentAt      DateTime?
  completedAt DateTime?

  // Metadata
  metadata    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  scheduledSMS ScheduledSMS[] @relation("CampaignSMS")

  @@index([eventId])
  @@index([status])
  @@index([scheduledFor])
}

enum SMSCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

// Scheduled SMS for individual scheduled messages
model ScheduledSMS {
  id          String   @id @default(cuid())

  // Guest and Event
  guestId     String
  guest       Guest    @relation("GuestScheduledSMS", fields: [guestId], references: [id], onDelete: Cascade)

  eventId     String
  event       Event    @relation("EventScheduledSMS", fields: [eventId], references: [id], onDelete: Cascade)

  // Campaign (optional)
  campaignId  String?
  campaign    SMSCampaign? @relation("CampaignSMS", fields: [campaignId], references: [id], onDelete: Cascade)

  // Message
  message     String   @db.Text
  templateName String? // Template name used for this message

  // Scheduling
  scheduledFor DateTime
  status      ScheduledSMSStatus @default(PENDING)

  // Execution
  sentAt      DateTime?
  notificationId String? // Reference to created Notification
  error       String?  @db.Text

  // Auto-resend configuration
  maxRetries  Int      @default(0)
  retryCount  Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([guestId])
  @@index([eventId])
  @@index([campaignId])
  @@index([status])
  @@index([scheduledFor])
}

enum ScheduledSMSStatus {
  PENDING
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

// SMS Opt-out management
model SMSOptOut {
  id          String   @id @default(cuid())

  // Guest or phone number
  guestId     String?
  guest       Guest?   @relation("GuestSMSOptOut", fields: [guestId], references: [id], onDelete: Cascade)

  phone       String   // Phone number that opted out (normalized format)

  // Opt-out details
  reason      String?  @db.Text // "STOP", "User request", etc.
  source      String   @default("manual") // "sms_reply", "manual", "api"

  // Metadata
  metadata    Json?

  optedOutAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([phone])
  @@index([guestId])
  @@index([phone])
}
