{
  "buildCommand": "npx prisma db push --accept-data-loss && prisma generate && next build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/process-scheduled-emails",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-scheduled-sms",
      "schedule": "*/5 * * * *"
    }
  ]
}
