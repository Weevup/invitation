# Base de données PostgreSQL (Neon, Vercel, etc.)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# URL publique de l'application (importante pour les liens d'invitation)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# Configuration Email - Méthode 1 : API (Recommandé)
# ============================================
# Choisissez votre provider : "resend" ou "sendgrid"
EMAIL_PROVIDER="resend"

# Resend API (https://resend.com) - Recommandé pour simplicité
# Créez un compte gratuit et obtenez votre clé API
# 100 emails/jour gratuits, configuration simple, tracking intégré
RESEND_API_KEY="re_your_api_key_here"

# OU SendGrid API (https://sendgrid.com)
# Alternative avec analytics avancés
# SENDGRID_API_KEY="SG.your_api_key_here"

# Informations expéditeur (doit être vérifié dans votre provider)
EMAIL_FROM="noreply@votredomaine.com"
EMAIL_FROM_NAME="Weevup Events"

# ============================================
# Configuration Email - Méthode 2 : SMTP (Legacy)
# ============================================
# Décommentez si vous préférez SMTP au lieu des APIs

# Option 1: Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre-email@gmail.com
# SMTP_PASSWORD=votre-mot-de-passe-app

# Option 2: SendGrid SMTP
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.votre-api-key

# Option 3: Mailjet
# SMTP_HOST=in-v3.mailjet.com
# SMTP_PORT=587
# SMTP_USER=votre-api-key
# SMTP_PASSWORD=votre-secret-key

# Option 4: Ethereal (pour tests uniquement - https://ethereal.email)
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre-user-ethereal
# SMTP_PASSWORD=votre-password-ethereal

# Sécurité JWT (optionnel, généré automatiquement si absent)
# JWT_SECRET="votre-secret-jwt-tres-securise"
