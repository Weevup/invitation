# Base de données PostgreSQL (Neon, Vercel, etc.)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# URL publique de l'application (importante pour les liens d'invitation)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# Configuration Email - NOUVELLE MÉTHODE (Via Interface Web)
# ============================================
# ⚠️  LES EMAILS SONT MAINTENANT CONFIGURÉS VIA L'INTERFACE WEB !
#
# Allez sur: /admin/settings/integrations
#
# Providers supportés:
# - SendGrid (https://sendgrid.com) - Recommandé pour production
# - Resend (https://resend.com) - Recommandé pour développeurs
# - Mailgun (https://mailgun.com) - Alternative robuste
# - SMTP Custom - Pour votre propre serveur
#
# Toutes les configurations (API keys, webhooks, tracking) se font
# dans l'interface et sont stockées de manière sécurisée en base de données.
#
# Les anciennes variables EMAIL_PROVIDER, RESEND_API_KEY, etc.
# ne sont PLUS utilisées et ont été supprimées du code.

# ============================================
# Sécurité et Encryption (OBLIGATOIRE en production)
# ============================================
# Clé de chiffrement pour les API keys et données sensibles
# Doit contenir au moins 32 caractères
# Générez avec: openssl rand -hex 32
ENCRYPTION_KEY="your-32-character-encryption-key-change-this"

# Secret JWT pour authentification des invités
# Générez avec: openssl rand -base64 32
JWT_SECRET="votre-secret-jwt-tres-securise"

# ============================================
# Configuration NextAuth (Authentification Admin)
# ============================================
# Secret pour signer les tokens JWT (OBLIGATOIRE en production)
# Générez avec: openssl rand -base64 32
AUTH_SECRET="votre-secret-nextauth-genere-aleatoirement"
# OU
# NEXTAUTH_SECRET="votre-secret-nextauth-genere-aleatoirement"

# URL de l'application pour NextAuth
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# Configuration Compte Admin
# ============================================
# Ces variables sont utilisées par le script npm run admin:create
ADMIN_EMAIL="admin@weevup.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Admin Weevup"

# ============================================
# Rate Limiting (Optionnel - Upstash Redis)
# ============================================
# Pour production, configurez Upstash Redis pour un rate limiting distribué
# En développement, un système en mémoire est utilisé automatiquement
# Créez un compte gratuit sur https://upstash.com
# UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token-here"

# ============================================
# Monitoring et Error Tracking (Sentry)
# ============================================
# Configuration Sentry pour le monitoring en production
# Créez un compte gratuit sur https://sentry.io
# 1. Créez un nouveau projet Next.js
# 2. Copiez le DSN fourni
# 3. Configurez l'organisation et le projet pour l'upload des source maps
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/your-project-id"
SENTRY_ORG="your-organization-slug"
SENTRY_PROJECT="your-project-name"

# Auth token pour l'upload des source maps (optionnel, pour production)
# Générez sur: https://sentry.io/settings/account/api/auth-tokens/
# SENTRY_AUTH_TOKEN="your-auth-token-here"

# ============================================
# Performance Monitoring (Web Vitals)
# ============================================
# Configuration pour le tracking des Core Web Vitals
# Les métriques sont automatiquement envoyées à Sentry (si configuré)
# Pour Vercel Analytics, ajoutez:
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID="your-analytics-id"
#
# Métriques trackées:
# - LCP (Largest Contentful Paint): Performance de chargement
# - FID (First Input Delay): Interactivité
# - CLS (Cumulative Layout Shift): Stabilité visuelle
# - FCP (First Contentful Paint): Premier rendu
# - TTFB (Time to First Byte): Temps de réponse serveur
# - INP (Interaction to Next Paint): Réactivité
