# Base de données PostgreSQL (Neon, Vercel, etc.)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# URL publique de l'application (importante pour les liens d'invitation)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# Configuration Email - Méthode 1 : API (Recommandé)
# ============================================
# Choisissez votre provider : "resend" ou "sendgrid"
EMAIL_PROVIDER="resend"

# Resend API (https://resend.com) - Recommandé pour simplicité
# Créez un compte gratuit et obtenez votre clé API
# 100 emails/jour gratuits, configuration simple, tracking intégré
RESEND_API_KEY="re_your_api_key_here"

# OU SendGrid API (https://sendgrid.com)
# Alternative avec analytics avancés
# SENDGRID_API_KEY="SG.your_api_key_here"

# Informations expéditeur (doit être vérifié dans votre provider)
EMAIL_FROM="noreply@votredomaine.com"
EMAIL_FROM_NAME="Weevup Events"

# ============================================
# Webhooks Email (Sécurité - OBLIGATOIRE en production)
# ============================================
# Ces secrets sont utilisés pour vérifier l'authenticité des webhooks
# OBLIGATOIRE en production pour éviter les requêtes malveillantes

# SendGrid: Public key pour vérification de signature
# Trouvez-le dans: Settings > Mail Settings > Event Webhook
# SENDGRID_WEBHOOK_PUBLIC_KEY="MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE..."

# Resend: Webhook secret (via Svix)
# Trouvez-le dans: Settings > Webhooks > Signing Secret
# RESEND_WEBHOOK_SECRET="whsec_..."

# Mailgun: Webhook signing key
# Trouvez-le dans: Settings > Webhooks > HTTP webhook signing key
# MAILGUN_WEBHOOK_SIGNING_KEY="your-mailgun-signing-key"

# ============================================
# Configuration Email - Méthode 2 : SMTP (Legacy)
# ============================================
# Décommentez si vous préférez SMTP au lieu des APIs

# Option 1: Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre-email@gmail.com
# SMTP_PASSWORD=votre-mot-de-passe-app

# Option 2: SendGrid SMTP
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.votre-api-key

# Option 3: Mailjet
# SMTP_HOST=in-v3.mailjet.com
# SMTP_PORT=587
# SMTP_USER=votre-api-key
# SMTP_PASSWORD=votre-secret-key

# Option 4: Ethereal (pour tests uniquement - https://ethereal.email)
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre-user-ethereal
# SMTP_PASSWORD=votre-password-ethereal

# ============================================
# Sécurité et Encryption (OBLIGATOIRE en production)
# ============================================
# Clé de chiffrement pour les API keys et données sensibles
# Doit contenir au moins 32 caractères
# Générez avec: openssl rand -hex 32
ENCRYPTION_KEY="your-32-character-encryption-key-change-this"

# Secret JWT pour authentification des invités
# Générez avec: openssl rand -base64 32
JWT_SECRET="votre-secret-jwt-tres-securise"

# ============================================
# Configuration NextAuth (Authentification Admin)
# ============================================
# Secret pour signer les tokens JWT (OBLIGATOIRE en production)
# Générez avec: openssl rand -base64 32
AUTH_SECRET="votre-secret-nextauth-genere-aleatoirement"
# OU
# NEXTAUTH_SECRET="votre-secret-nextauth-genere-aleatoirement"

# URL de l'application pour NextAuth
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# Configuration Compte Admin
# ============================================
# Ces variables sont utilisées par le script npm run admin:create
ADMIN_EMAIL="admin@weevup.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Admin Weevup"

# ============================================
# Rate Limiting (Optionnel - Upstash Redis)
# ============================================
# Pour production, configurez Upstash Redis pour un rate limiting distribué
# En développement, un système en mémoire est utilisé automatiquement
# Créez un compte gratuit sur https://upstash.com
# UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token-here"
