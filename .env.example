# Database
DATABASE_URL="postgresql://user:password@localhost:5432/invitation_manager?schema=public"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Email Configuration (choose one provider)
# For development, you can use nodemailer with a test account
EMAIL_FROM="noreply@invitation-manager.com"
EMAIL_FROM_NAME="Invitation Manager"

# Option 1: Resend (recommended for production)
# RESEND_API_KEY="re_xxx"

# Option 2: SMTP (nodemailer)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# Optional: SendGrid
# SENDGRID_API_KEY="SG.xxx"

# Node environment
NODE_ENV="development"
